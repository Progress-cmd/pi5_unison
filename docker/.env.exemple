# Modèle de configuration — copier en « .env » et compléter.
#
#   cp docker/.env.exemple docker/.env
#
# Le vrai .env n'est pas versionné (il contient les mots de passe) : ce fichier
# sert de référence pour savoir ce qui est attendu. Toute variable manquante
# provoque au démarrage un avertissement du type :
#
#   WARN The "APP_URL" variable is not set. Defaulting to a blank string.
#
# Quand une variable est ajoutée au code, elle doit l'être ici aussi.


# --- Cible de construction -------------------------------------------------
# development : erreurs affichées, opcache désactivé, MailHog
# production  : erreurs masquées, open_basedir, disable_functions
DOCKER_TARGET=development


# --- Base de données -------------------------------------------------------
DB_ROOTPASS=changez-moi
DB_NAME=unison
DB_USER=unison
DB_PASS=changez-moi

# Base de la démonstration. Facultatif : par défaut « <DB_NAME>_demo ».
# Doit impérativement se terminer par « _demo » — demo_data/installer.sh
# refuse de s'exécuter autrement, car il fait un DROP DATABASE.
#DB_NAME_DEMO=unison_demo


# --- Recherche -------------------------------------------------------------
MS_PASS=changez-moi


# --- Courrier --------------------------------------------------------------
# En développement, MailHog intercepte tout : hôte « mail », port 1025.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASS=changez-moi


# --- Accès -----------------------------------------------------------------
PORT_EXPOSE=8082

# URL publique de l'application, utilisée pour construire les liens envoyés
# par courriel (réinitialisation de mot de passe).
#
# Sans elle, l'application se rabat sur le ServerName du vhost avec le schéma
# de la connexion interne : derrière Traefik, qui termine le TLS, cela produit
# des liens en « http:// » au lieu de « https:// ».
#
# Ne JAMAIS déduire cette valeur de l'en-tête Host : il est contrôlé par le
# client, et un Host falsifié enverrait dans une vraie boîte mail un lien
# pointant vers un serveur tiers.
APP_URL=http://localhost:8082
#APP_URL=https://unison.pi5.ovh
